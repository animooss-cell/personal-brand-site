NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SITE_URL=https://aiabed.ir

# اختیاری — فقط بعد از تأیید با curl (رجوع کنید به lib/image-loader.ts) تنظیم
# شود: "supabase" یا "cloudflare". اگر خالی بماند، تصویرها بدون تبدیل سرو
# می‌شوند (رفتار فعلی).
NEXT_PUBLIC_IMAGE_TRANSFORM=

# فقط برای اجرای محلی scripts/compress-existing-images.ts لازم است (نه برای
# خود سایت). از Supabase Dashboard → Project Settings → API → service_role.
# هرگز commit نشود یا در سمت مرورگر استفاده نشود — RLS را دور می‌زند.
SUPABASE_SERVICE_ROLE_KEY=
