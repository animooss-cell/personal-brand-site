NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SITE_URL=https://aiabed.ir

# اختیاری — رجوع کنید به lib/image-loader.ts. اگر خالی بماند، پیش‌فرض
# "supabase" است (با تست مرورگری تأیید شده: PNG ۱۵۰۶KB → WebP ~۴۵KB).
# مقادیر ممکن: "supabase" (پیش‌فرض)، "cloudflare"، یا "off"/"none" برای
# خاموش کردن کامل تبدیل (تصویرها بدون تغییر سرو می‌شوند).
NEXT_PUBLIC_IMAGE_TRANSFORM=

# فقط برای اجرای محلی scripts/compress-existing-images.ts لازم است (نه برای
# خود سایت). از Supabase Dashboard → Project Settings → API → service_role.
# هرگز commit نشود یا در سمت مرورگر استفاده نشود — RLS را دور می‌زند.
SUPABASE_SERVICE_ROLE_KEY=
